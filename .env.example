# Copy to .env for local development. Every value here is a safe local placeholder.
# Never commit a real .env. In production, inject these through your secret manager.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# PostgreSQL (docker compose exposes it on 5432 with these credentials)
DATABASE_URL=postgres://scaleflow:scaleflow@localhost:5432/scaleflow
# Optional read replica; leave unset to read from the primary
# DATABASE_READ_URL=postgres://scaleflow:scaleflow@localhost:5433/scaleflow
DATABASE_POOL_MAX=20

REDIS_URL=redis://localhost:6379/0

# Listen only on this computer. (Containers override this with 0.0.0.0.)
API_HOST=127.0.0.1
OPS_HOST=127.0.0.1
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Blocks webhook jobs from calling localhost / private IPs (SSRF protection). Only set to true if you
# deliberately test against a receiver on your own machine - and never in production.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_SIGNING_SECRET=change-me-local-webhook-secret

WORKER_CONCURRENCY=10

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000
