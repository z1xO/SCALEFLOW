{
  "name": "scaleflow",
  "private": true,
  "description": "ScaleFlow - an open-source distributed job processing and event delivery platform",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/server",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,relay,sched,web -c blue,green,yellow,magenta,cyan \"npm:dev:api -w @scaleflow/server\" \"npm:dev:worker -w @scaleflow/server\" \"npm:dev:relay -w @scaleflow/server\" \"npm:dev:scheduler -w @scaleflow/server\" \"npm:dev -w @scaleflow/dashboard\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @scaleflow/server",
    "test:unit": "npm run test:unit -w @scaleflow/server",
    "test:integration": "npm run test:integration -w @scaleflow/server",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "npm run db:migrate -w @scaleflow/server",
    "db:seed": "npm run db:seed -w @scaleflow/server"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10"
  }
}
