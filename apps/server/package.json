{
  "name": "@scaleflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScaleFlow backend: API, workers, outbox relay and scheduler (one codebase, separate processes)",
  "license": "MIT",
  "scripts": {
    "dev:api": "tsx watch --clear-screen=false src/processes/api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/processes/worker.ts",
    "dev:relay": "tsx watch --clear-screen=false src/processes/relay.ts",
    "dev:scheduler": "tsx watch --clear-screen=false src/processes/scheduler.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/processes/api.js",
    "start:worker": "node dist/processes/worker.js",
    "start:relay": "node dist/processes/relay.js",
    "start:scheduler": "node dist/processes/scheduler.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "projections:rebuild": "tsx src/cli/rebuild-projections.ts",
    "openapi": "tsx src/cli/openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prometheus-io/client": "0.16.1",
    "bullmq": "6.3.17",
    "cron-parser": "5.10.2",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
